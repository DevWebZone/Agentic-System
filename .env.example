# Application
APP_NAME=Agentic URL Shortener
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///./agentic_url_shortener.db

# Optional LLM requirements analysis. The system defaults to deterministic agents.
LLM_REQUIREMENTS_ENABLED=false
OPENAI_API_KEY=
REQUIREMENTS_MODEL=gpt-4.1-mini
LLM_MAX_OUTPUT_TOKENS=1200

# Stage model routing is recorded for governance and future provider expansion.
PLANNING_MODEL=Sol
CODE_MODEL=Terra
GATE_MODEL=Luna
