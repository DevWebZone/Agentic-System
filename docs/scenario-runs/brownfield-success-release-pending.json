      "node_key": "implementation",
      "artifact_type": "brownfield_patch_report",
      "summary": "Brownfield patch passed isolated pytest validation.",
      "content": {
        "patch": [
          {
            "op": "replace",
            "path": "src/app/shortener/validation.py",
            "old_text": "import re\n",
            "new_text": "import ipaddress\nimport re\n"
          },
          {
            "op": "replace",
            "path": "src/app/shortener/validation.py",
            "old_text": "    if parsed.username or parsed.password:\n        raise ValueError(\"original_url must not contain embedded credentials.\")\n    return urlunsplit((parsed.scheme.lower(), parsed.netloc, parsed.path, parsed.query, \"\"))\n",
            "new_text": "    if parsed.username or parsed.password:\n        raise ValueError(\"original_url must not contain embedded credentials.\")\n    host = (parsed.hostname or \"\").rstrip(\".\").lower()\n    if host == \"localhost\" or host.endswith(\".localhost\"):\n        raise ValueError(\n            \"original_url must not point to a local or private network host.\"\n        )\n    try:\n        address = ipaddress.ip_address(host)\n    except ValueError:\n        address = None\n    if address is not None and (\n        address.is_loopback or address.is_private or address.is_link_local\n    ):\n        raise ValueError(\n            \"original_url must not point to a local or private network host.\"\n        )\n    return urlunsplit((parsed.scheme.lower(), parsed.netloc, parsed.path, parsed.query, \"\"))\n"
          },
          {
            "op": "create",
            "path": "tests/test_shortener_destination_security.py",
            "old_text": "",
            "new_text": "from fastapi.testclient import TestClient\nimport pytest\n\nfrom app.shortener.validation import normalize_destination_url\n\n\n@pytest.mark.parametrize(\n    \"url\",\n    [\n        \"http://localhost/private\",\n        \"http://127.0.0.1/private\",\n        \"http://10.2.3.4/private\",\n        \"http://172.16.1.2/private\",\n        \"http://192.168.1.2/private\",\n        \"http://169.254.1.2/private\",\n        \"http://[::1]/private\",\n    ],\n)\ndef test_local_and_private_destination_hosts_are_rejected(url: str) -> None:\n    with pytest.raises(ValueError, match=\"local or private network\"):\n        normalize_destination_url(url)\n\n\ndef test_public_destination_remains_accepted() -> None:\n    assert normalize_destination_url(\"https://example.com/path\") == \"https://example.com/path\"\n\n\ndef test_local_destination_preserves_validation_error_shape(\n    client: TestClient,\n) -> None:\n    response = client.post(\n        \"/api/v1/links\",\n        json={\"original_url\": \"http://localhost/private\"},\n    )\n\n    assert response.status_code == 422\n    assert set(response.json()) == {\"error\", \"detail\", \"request_id\"}\n"
          }
        ],
        "proposed_by": "brownfield_implementation",
        "patch_paths": [
